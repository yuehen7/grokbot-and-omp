#!/usr/bin/env bash
# OMP model-path preflight before omp-task runs.
# Copy to bin/omp-preflight (or set OMP_TASK_PREFLIGHT) and adjust the URL and
# service-restart paths below.
#
# Hosts sleep often; after wake, userspace Tailscale may lose the coordination
# server and fall back to slow DERP relay, so requests hang ~2 min and die with
# UND_ERR_SOCKET even though the local gateway port is open.
#
# Checks: /api/hello -> 401 within 3s, no recent wake (time jump < 5 min),
# map-poll not in error.
# If anything is off: force Tailscale down/up + forwarder, then wait (<= ~2 min)
# until healthy. Exit 0 = healthy, 1 = still bad (omp-task warns and continues).
# Prints to stderr only.
set -u
URL=${OMP_PREFLIGHT_URL:-http://127.0.0.1:3425/api/hello}   # gateway health URL; 401 = up (auth required)
LOG=${TS_LOG:-/path/to/tailscaled.log}
STAMP=/tmp/omp-preflight.ok
TS="${TS_CLI:-tailscale}"
code=000; t=99
probe(){ local r; r=$(curl -s -o /dev/null -w '%{http_code} %{time_total}' -m 10 "$URL" 2>/dev/null) || r="000 99"
  code=${r%% *}; t=${r##* }; [ "$code" = 401 ] && awk "BEGIN{exit !($t < 3)}"; }
recent_wake(){ local l ts; l=$(grep "time jump detected" "$LOG" 2>/dev/null | tail -1) || return 1; [ -n "$l" ] || return 1
  ts=$(date -d "$(echo "$l" | awk '{print $1" "$2}' | tr / -)" +%s 2>/dev/null) || return 1; [ $(( $(date +%s) - ts )) -lt 300 ] || return 1
  # already reconnected since that wake? then it's fine
  [ -f "$STAMP" ] && [ "$(stat -c %Y "$STAMP")" -gt "$ts" ] && return 1; return 0; }
map_err(){ grep "warnable=not-in-map-poll" "$LOG" 2>/dev/null | tail -1 | grep -q "error"; }
online(){ timeout 5 $TS status --json 2>/dev/null | python3 -c 'import json,sys;d=json.load(sys.stdin);sys.exit(0 if d.get("BackendState")=="Running" and (d.get("Self") or {}).get("Online") else 1)' 2>/dev/null; }

why=""
probe || why="hello=$code ${t}s"
recent_wake && why="$why recent-wake"
map_err && why="$why map-poll-error"
[ -z "$why" ] && exit 0

echo "omp-preflight: model path not ready ($why); reconnecting Tailscale..." >&2
timeout 10 $TS down >/dev/null 2>&1 || true
bash "${TS_START:-/path/to/tailscale-start.sh}" >/dev/null 2>&1
bash "${FORWARD_START:-/path/to/forwarder-start.sh}" >/dev/null 2>&1
for i in $(seq 1 12); do
  if online && probe; then touch "$STAMP"; echo "omp-preflight: ok (hello ${t}s)" >&2; exit 0; fi
  sleep 10
done
echo "omp-preflight: still not healthy after ~2 min (hello=$code ${t}s); running anyway" >&2
exit 1
